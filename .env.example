# Public browser config (Vite exposes only VITE_* variables).
# Prefer an empty base URL so the app calls same-origin `/api/v1/...`.
# In local development, Vite proxies `/api` to the Spring API target below.
VITE_API_BASE_URL=

# Spring API origin used by the Vite dev proxy only (not sent to the browser bundle).
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
